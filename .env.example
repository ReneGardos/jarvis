# ===== Jarvis konfiguration =====
# Kopiér til .env og udfyld. Generér hemmeligheder med: python3 scripts/gen_secrets.py

# --- Påkrævet ---
POSTGRES_PASSWORD=
QDRANT_API_KEY=
# 32-byte urlsafe base64 (Fernet). Krypterer API-nøgler og følsomme felter i databasen.
JARVIS_MASTER_KEY=
# Signering af login-tokens
JWT_SECRET=
# Din bruger (oprettes ved første opstart, adgangskoden hashes med scrypt)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Netværk ---
PUBLIC_API_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000
JARVIS_DOMAIN=jarvis.local

# --- Lokale modeller (Ollama) ---
OLLAMA_DEFAULT_MODEL=qwen2.5:7b-instruct
OLLAMA_LARGE_MODEL=qwen2.5:14b-instruct
OLLAMA_CODE_MODEL=qwen2.5-coder:7b
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Cloud (valgfrit). Kan også lægges ind krypteret via Model Management i dashboardet ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Hårdt loft for cloudforbrug pr. måned i DKK. Routeren falder tilbage til lokal model når loftet nås.
CLOUD_BUDGET_DKK_MONTH=400

# --- Søgning ---
# SearXNG kører lokalt i docker-compose (gratis). Brave er valgfri ekstra kilde.
BRAVE_API_KEY=

# --- Kalender (Apple iCloud via CalDAV) ---
# App-specifik adgangskode: appleid.apple.com -> Log ind og sikkerhed -> App-specifikke adgangskoder
CALDAV_URL=https://caldav.icloud.com
CALDAV_USERNAME=
CALDAV_PASSWORD=

# --- Notifikationer ---
# ntfy (gratis app til iOS/Android). Brug et langt, hemmeligt emnenavn.
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL=

# --- Filadgang ---
# Mappe på værten som monteres i /workspace. AI'en kan læse her; skrivning kræver din godkendelse.
WORKSPACE_HOST_PATH=./data/workspace

# --- Stemme ---
WHISPER_MODEL=small
PIPER_VOICE=da_DK-talesyntese-medium
